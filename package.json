{
  "name": "drift-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A calm personal desktop browser",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "pack:win": "npm run build && electron-builder --win --dir --publish never",
    "measure": "npm run build && node scripts/measure.mjs",
    "test:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-content": "2.20.2",
    "@ghostery/adblocker-electron": "2.20.1",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-store": "12.0.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts": "7.4.19"
  },
  "overrides": {
    "electron-chrome-web-store": {
      "adm-zip": "0.6.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
